      "Read(backups/**)",
      "Read(exports/**/*.csv)",
      "Read(exports/**/*.xlsx)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
